<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <THE-HEADER>
    <REQ-IF-HEADER IDENTIFIER="REQ-IF-HEADER">
      <CREATION-TIME>2026-01-01T00:00:00+00:00</CREATION-TIME>
      <REQ-IF-TOOL-ID>reqif</REQ-IF-TOOL-ID>
      <REQ-IF-VERSION>1.0</REQ-IF-VERSION>
      <SOURCE-TOOL-ID>reqif</SOURCE-TOOL-ID>
      <TITLE>Example: Extract requirement text</TITLE>
    </REQ-IF-HEADER>
  </THE-HEADER>
  <CORE-CONTENT>
    <REQ-IF-CONTENT>
      <DATATYPES>
        <DATATYPE-DEFINITION-STRING IDENTIFIER="DATATYPE-STRING" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="String" MAX-LENGTH="1000"/>
        <DATATYPE-DEFINITION-XHTML IDENTIFIER="DATATYPE-XHTML" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="XHTML"/>
      </DATATYPES>
      <SPEC-TYPES>
        <SPEC-OBJECT-TYPE IDENTIFIER="SPEC-OBJECT-TYPE-REQUIREMENT" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="Requirement">
          <SPEC-ATTRIBUTES>
            <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="ATTRIBUTE-FOREIGN-ID" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="ReqIF.ForeignID">
              <TYPE>
                <DATATYPE-DEFINITION-STRING-REF>DATATYPE-STRING</DATATYPE-DEFINITION-STRING-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-STRING>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="ATTRIBUTE-CHAPTER-NAME" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="ReqIF.ChapterName">
              <TYPE>
                <DATATYPE-DEFINITION-XHTML-REF>DATATYPE-XHTML</DATATYPE-DEFINITION-XHTML-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-XHTML>
            <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="ATTRIBUTE-TEXT" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="ReqIF.Text">
              <TYPE>
                <DATATYPE-DEFINITION-XHTML-REF>DATATYPE-XHTML</DATATYPE-DEFINITION-XHTML-REF>
              </TYPE>
            </ATTRIBUTE-DEFINITION-XHTML>
          </SPEC-ATTRIBUTES>
        </SPEC-OBJECT-TYPE>
        <SPECIFICATION-TYPE IDENTIFIER="SPECIFICATION-TYPE" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="Specification"/>
      </SPEC-TYPES>
      <SPEC-OBJECTS>
        <SPEC-OBJECT IDENTIFIER="SPEC-OBJECT-SECTION-1" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="Login section">
          <VALUES>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>ATTRIBUTE-CHAPTER-NAME</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>Login</xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SPEC-OBJECT-TYPE-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SPEC-OBJECT-REQ-1" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="Password length">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-1">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>ATTRIBUTE-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>ATTRIBUTE-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>The system <xhtml:b>shall</xhtml:b> reject passwords shorter than 12 characters.</xhtml:p>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SPEC-OBJECT-TYPE-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SPEC-OBJECT-REQ-2" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="Failed logins">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="REQ-2">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>ATTRIBUTE-FOREIGN-ID</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
            <ATTRIBUTE-VALUE-XHTML>
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-XHTML-REF>ATTRIBUTE-TEXT</ATTRIBUTE-DEFINITION-XHTML-REF>
              </DEFINITION>
              <THE-VALUE>
                <xhtml:div>
                  <xhtml:p>The system <xhtml:b>shall</xhtml:b> lock an account after:</xhtml:p>
                  <xhtml:ul>
                    <xhtml:li>5 failed login attempts, or</xhtml:li>
                    <xhtml:li>an administrator request.</xhtml:li>
                  </xhtml:ul>
                </xhtml:div>
              </THE-VALUE>
            </ATTRIBUTE-VALUE-XHTML>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SPEC-OBJECT-TYPE-REQUIREMENT</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
      </SPEC-OBJECTS>
      <SPECIFICATIONS>
        <SPECIFICATION IDENTIFIER="SPECIFICATION-1" LAST-CHANGE="2026-01-01T00:00:00+00:00" LONG-NAME="System requirements">
          <TYPE>
            <SPECIFICATION-TYPE-REF>SPECIFICATION-TYPE</SPECIFICATION-TYPE-REF>
          </TYPE>
          <CHILDREN>
            <SPEC-HIERARCHY IDENTIFIER="SPEC-HIERARCHY-SECTION-1" LAST-CHANGE="2026-01-01T00:00:00+00:00">
              <OBJECT>
                <SPEC-OBJECT-REF>SPEC-OBJECT-SECTION-1</SPEC-OBJECT-REF>
              </OBJECT>
              <CHILDREN>
                <SPEC-HIERARCHY IDENTIFIER="SPEC-HIERARCHY-REQ-1" LAST-CHANGE="2026-01-01T00:00:00+00:00">
                  <OBJECT>
                    <SPEC-OBJECT-REF>SPEC-OBJECT-REQ-1</SPEC-OBJECT-REF>
                  </OBJECT>
                </SPEC-HIERARCHY>
                <SPEC-HIERARCHY IDENTIFIER="SPEC-HIERARCHY-REQ-2" LAST-CHANGE="2026-01-01T00:00:00+00:00">
                  <OBJECT>
                    <SPEC-OBJECT-REF>SPEC-OBJECT-REQ-2</SPEC-OBJECT-REF>
                  </OBJECT>
                </SPEC-HIERARCHY>
              </CHILDREN>
            </SPEC-HIERARCHY>
          </CHILDREN>
        </SPECIFICATION>
      </SPECIFICATIONS>
    </REQ-IF-CONTENT>
  </CORE-CONTENT>
</REQ-IF>
